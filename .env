# انسخي الملف ده باسم .env واملي القيم قبل ما تنشري السيرفر فعليًا
# لو سيبتيهم زي ما هما، السيرفر هيشتغل بإعدادات تجريبية غير آمنة للنشر الحقيقي

PORT=3000

# اسم مستخدم الأدمن (اللي بتدخلي بيه على لوحة التحكم)
ADMIN_USERNAME=admin1

# مايتحطش الباسورد هنا كنص عادي — شغّلي هذا الأمر لتوليد الهاش:
#   node scripts/hash-password.js "كلمة-السر-بتاعتك"
# وحطي الناتج هنا:
ADMIN_PASSWORD_HASH=$2a$10$0J5TSU4pUWZOI5GDjfTNzOfKriudITqKbvjHQCRwlT.KOF1z9goKe

# مفتاح توقيع جلسة تسجيل الدخول — غيّريه لأي نص عشوائي طويل قبل النشر
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING

# **الأهم**: نفس القيمة دي لازم تكون مطابقة تمامًا في:
#  - ملف license.js هنا في السيرفر
#  - مولد-التراخيص.html
#  - كود تطبيق شاشة الأسعار (current.html / Electron)
# لو غيّرتيها هنا لازم تغيّريها في الأماكن التلاتة الباقية بنفس القيمة بالظبط
LICENSE_SECRET=SHARQAWY-FX-LICENSE-2026-K7m9Qx2Lp4Rt8Vb
